# Fluxo auditável do sistema fuzzy Mamdani
# d2 --layout elk --pad 32 fuzzy-prioritization.d2 fuzzy-prioritization.svg

direction: down
grid-columns: 1
grid-gap: 32
style.fill: "#FFFFFF"

classes: {
  input: {
    style: {
      fill: "#E3F2FD"
      stroke: "#1565C0"
      stroke-width: 2
      border-radius: 8
      font-size: 16
    }
  }
  process: {
    style: {
      fill: "#FFF8E1"
      stroke: "#F57F17"
      stroke-width: 2
      border-radius: 8
      font-size: 17
    }
  }
  rules: {
    style: {
      fill: "#F3E5F5"
      stroke: "#7B1FA2"
      stroke-width: 2
      border-radius: 8
      font-size: 15
    }
  }
  output: {
    style: {
      fill: "#E8F5E9"
      stroke: "#2E7D32"
      stroke-width: 2
      border-radius: 8
      font-size: 16
    }
  }
  row: {
    style: {
      fill: transparent
      stroke: transparent
    }
  }
  spacer: {
    style: {
      fill: transparent
      stroke: transparent
      opacity: 0
    }
  }
}

input_row: "" {
  grid-columns: 3
  grid-gap: 20
  class: row

  behavior: "Medir a contradição\nCompara intenção, contrato\ne resposta" {
    class: input
    width: 320
  }
  evidence: "Medir a força da evidência\n0,5 inicialmente; 1,0 em falha\nde transporte ou 5xx recorrente" {
    class: input
    width: 320
  }
  access: "Medir a exposição de acesso\n0 normal; 0,6 credencial inválida;\n1,0 credencial ausente" {
    class: input
    width: 320
  }
}

fuzz_row: "" {
  grid-columns: 3
  grid-gap: 0
  class: row

  fuzz_left: "" { class: spacer }
  fuzzification: "Converter valores em graus de pertinência\nContradição: baixa, média ou alta\nEvidência: limitada ou forte\nExposição: nenhuma, potencial ou clara" {
    class: process
    width: 760
  }
  fuzz_right: "" { class: spacer }
}

rule_row: "" {
  grid-columns: 2
  grid-gap: 28
  class: row

  behavior_rules: "Interpretar o comportamento\nR1: baixa → LOW\nR2: média → MEDIUM\nR3: alta + evidência limitada → MEDIUM\nR4: alta + evidência forte → HIGH" {
    class: rules
    width: 470
  }
  access_rules: "Interpretar o controle de acesso\nR5: exposição potencial → MEDIUM\nR6: exposição clara → HIGH" {
    class: rules
    width: 470
  }
}

inference_row: "" {
  grid-columns: 3
  grid-gap: 0
  class: row

  inference_left: "" { class: spacer }
  inference: "Combinar as regras e calcular a pontuação\nAgregação Mamdani e desfuzzificação pelo centroide" {
    class: process
    width: 760
  }
  inference_right: "" { class: spacer }
}

output_row: "" {
  grid-columns: 2
  grid-gap: 28
  class: row

  priority: "Classificar a prioridade técnica\nLOW < 0,33; MEDIUM entre 0,33 e 0,66; HIGH ≥ 0,66" {
    class: output
    width: 470
  }
  audit: "Explicar a decisão\nRegistra entradas, pertinências,\nregras ativadas e eventual regra alternativa" {
    class: output
    width: 470
  }
}

input_row.behavior -> fuzz_row.fuzzification: "valores observados"
input_row.evidence -> fuzz_row.fuzzification
input_row.access -> fuzz_row.fuzzification
fuzz_row.fuzzification -> rule_row.behavior_rules: "graus de pertinência"
fuzz_row.fuzzification -> rule_row.access_rules
rule_row.behavior_rules -> inference_row.inference: "regras ativadas"
rule_row.access_rules -> inference_row.inference
inference_row.inference -> output_row.priority: "pontuação"
inference_row.inference -> output_row.audit: "rastreabilidade"
